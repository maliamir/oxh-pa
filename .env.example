APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SEED_ON_STARTUP=true

# PostgreSQL 16 connection strings (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://oxh_user:oxh_password@localhost:5432/oxh_prior_auth
TEST_DATABASE_URL=postgresql+psycopg://oxh_user:oxh_password@localhost:5432/oxh_prior_auth_test

# Local HS256 JWT settings (demo/local only; must be overridden outside development/test)
JWT_SECRET_KEY=oxh-local-dev-secret-change-in-production-32chars-min
JWT_ALGORITHM=HS256
JWT_ISSUER=oxh-identity
JWT_AUDIENCE=oxh-pa
JWT_ACCESS_TOKEN_EXPIRE_HOURS=720
