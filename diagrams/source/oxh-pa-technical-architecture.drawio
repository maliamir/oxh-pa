  <diagram id="tech-review" name="05 Reviewer Workflow and State">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" page="1" pageWidth="1400" pageHeight="950" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="Technical Architecture · Reviewer Workflow and State Machine" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="210" y="25" width="980" height="40" as="geometry"/></mxCell>
      <mxCell id="submitted" value="SUBMITTED&#xa;unassigned · FIFO queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=3;fontColor=#075985;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="170" y="125" width="260" height="90" as="geometry"/></mxCell>
      <mxCell id="review" value="IN_REVIEW&#xa;one assigned reviewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=3;fontColor=#6B21A8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="125" width="260" height="90" as="geometry"/></mxCell>
      <mxCell id="decided" value="DECIDED&#xa;complete immutable decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=3;fontColor=#065F46;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="970" y="125" width="260" height="90" as="geometry"/></mxCell>
      <mxCell id="claim" value="atomic conditional claim&#xa;+ conflict exclusion" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#9333EA;strokeWidth=3;fontColor=#6B21A8;" edge="1" parent="1" source="submitted" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="decide" value="complete valid procedure set&#xa;+ row lock + one transaction" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#059669;strokeWidth=3;fontColor=#065F46;" edge="1" parent="1" source="review" target="decided"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="reassign" value="ADMIN REASSIGN&#xa;in_review only · active reviewer&#xa;no treating conflict · status unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="280" height="90" as="geometry"/></mxCell>
      <mxCell id="loop" value="status unchanged" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;" edge="1" parent="1" source="reassign" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="none" value="NO TRANSITIONS&#xa;no reopen · no appeal · no retro review&#xa;no partial decision · no return to submitted" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="940" y="270" width="320" height="90" as="geometry"/></mxCell>
      <mxCell id="q" value="1 · QUEUE&#xa;status=submitted · oldest first&#xa;exclude reviewer_patients&#xa;clinical note withheld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;" vertex="1" parent="1"><mxGeometry x="90" y="465" width="270" height="120" as="geometry"/></mxCell>
      <mxCell id="c" value="2 · CLAIM RACE&#xa;conditional UPDATE requires submitted + unassigned&#xa;one winner · loser 409&#xa;append authorization.claimed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;" vertex="1" parent="1"><mxGeometry x="405" y="450" width="300" height="150" as="geometry"/></mxCell>
      <mxCell id="a" value="3 · ASSIGNED ACCESS&#xa;only current assignee reads note&#xa;stale reviewer gets 404&#xa;conflict rechecked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;" vertex="1" parent="1"><mxGeometry x="750" y="465" width="270" height="120" as="geometry"/></mxCell>
      <mxCell id="d" value="4 · FINAL DECISION&#xa;SELECT FOR UPDATE&#xa;exactly one decision per procedure&#xa;parent decider/time + audit in same commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="1060" y="450" width="290" height="150" as="geometry"/></mxCell>
      <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="q" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="c" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="a" target="d"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="guards" value="DEFENSE IN DEPTH&#xa;Application: valid transition + assignment + conflict + completeness&#xa;Database: allowed status + decided actor/time + unique procedure decision + append-only triggers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="715" width="900" height="100" as="geometry"/></mxCell>
    </root></mxGraphModel>
