  <diagram id="tech-diagnostics" name="07 Diagnostics and Error Flow">
    <mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1450" pageHeight="900" background="#F8FAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="Technical Architecture · Request Diagnostics and Error Flow" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="245" y="25" width="960" height="40" as="geometry"/></mxCell>
      <mxCell id="s" value="Server request identity · client correlation · RFC 9457 errors · PHI-minimized support evidence" style="text;html=1;align=center;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="350" y="65" width="750" height="25" as="geometry"/></mxCell>
      <mxCell id="client" value="CLIENT&#xa;optional X-Correlation-ID&#xa;incoming X-Request-ID is fallback correlation only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="280" height="100" as="geometry"/></mxCell>
      <mxCell id="middleware" value="MIDDLEWARE&#xa;always generate server UUID request_id&#xa;trim correlation to 128 chars&#xa;echo response headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="145" width="300" height="120" as="geometry"/></mxCell>
      <mxCell id="validation" value="SCHEMA / AUTH / DOMAIN&#xa;validation codes + field paths&#xa;business and authorization checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="155" width="290" height="100" as="geometry"/></mxCell>
      <mxCell id="success" value="SUCCESS PATH&#xa;normal response projection&#xa;X-Request-ID + correlation header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="115" width="280" height="100" as="geometry"/></mxCell>
      <mxCell id="problem" value="PROBLEM DETAIL&#xa;application/problem+json&#xa;type · title · status · detail · instance&#xa;code · IDs · errors[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="260" width="280" height="125" as="geometry"/></mxCell>
      <mxCell id="accesslog" value="PHI-SAFE ACCESS LOG&#xa;method · path · status · duration&#xa;request ID · correlation ID&#xa;NO headers · body · note · PHI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="390" y="400" width="300" height="115" as="geometry"/></mxCell>
      <mxCell id="mainTx" value="MAIN BUSINESS TRANSACTION&#xa;authorization + procedures + audit&#xa;commit together or rollback together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#115E59;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="300" height="100" as="geometry"/></mxCell>
      <mxCell id="diag" value="INDEPENDENT DIAGNOSTIC SESSION&#xa;accepted create/replay or rejected attempt&#xa;request/correlation IDs · actors · flags · codes&#xa;NO raw payload or clinical note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="610" width="350" height="135" as="geometry"/></mxCell>
      <mxCell id="db" value="POSTGRESQL&#xa;PHI business records&#xa;separate minimal diagnostics" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=3;fontColor=#065F46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="545" width="220" height="110" as="geometry"/></mxCell>
      <mxCell id="support" value="ADMIN SUPPORT LOOKUP&#xa;search by request ID or correlation ID&#xa;newest matching attempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="710" width="290" height="95" as="geometry"/></mxCell>
      <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="client" target="middleware"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#9333EA;strokeWidth=2;" edge="1" parent="1" source="middleware" target="validation"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e3" value="valid" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;" edge="1" parent="1" source="validation" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="failure" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;" edge="1" parent="1" source="validation" target="problem"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e5" value="one line per response" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#64748B;" edge="1" parent="1" source="middleware" target="accesslog"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e6" value="business operation" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#0F766E;strokeWidth=2;" edge="1" parent="1" source="validation" target="mainTx"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e7" value="independent / best effort" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;" edge="1" parent="1" source="validation" target="diag"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="mainTx" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#EA580C;strokeWidth=2;" edge="1" parent="1" source="diag" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#EA580C;strokeWidth=2;" edge="1" parent="1" source="support" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="note" value="Readiness is separate: /health/live reports process liveness; /health/ready executes SELECT 1 and returns 503 when PostgreSQL is unavailable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="250" y="820" width="900" height="55" as="geometry"/></mxCell>
    </root></mxGraphModel>
